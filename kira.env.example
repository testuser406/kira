# Copy to kira.env (same folder) and edit. Lines are KEY=VALUE, '#' starts a comment. No quotes needed.
# kira.env is ignored by git because it contains passwords.

# --- Dashboard login ---------------------------------------------------------
# First administrator, created only when no users exist yet (10-128 characters).
ADMIN_USERNAME=admin
ADMIN_PASSWORD=change-this-long-password
SESSION_HOURS=12

# --- Network -----------------------------------------------------------------
API_ADDR=0.0.0.0:8080
SYSLOG_UDP_ADDR=0.0.0.0:5514
SYSLOG_TCP_ADDR=0.0.0.0:5514
HEALTH_ADDR=0.0.0.0:8081

# --- Site --------------------------------------------------------------------
TENANT_SLUG=default
TENANT_NAME=Head office
# Offset in minutes for timezone abbreviations the collector does not know (Pakistan = 300).
DEFAULT_TZ_OFFSET_MINUTES=300
# Only accept syslog from these sources (comma separated IPs/CIDRs). Leave unset to accept all.
# ALLOWED_SOURCES=172.16.0.1

# --- Storage / pipeline ------------------------------------------------------
RETENTION_HOURS=6
KEEP_EXTENDED_ATTRIBUTES=false
# Drop records that cost storage but add no reporting value (recommended below).
DROP_NOISE=conn_start,ip_spoof_broadcast
RESOLVE_USERS=true
IP_USER_TTL_MINUTES=240

# --- E-mail for reports and alerts (optional) ---------------------------------
# SMTP_HOST=smtp.example.com
# SMTP_PORT=587
# SMTP_USERNAME=
# SMTP_PASSWORD=
# SMTP_FROM=

# --- PostgreSQL ---------------------------------------------------------------
# Folder holding initdb.exe / pg_ctl.exe. Leave empty to auto-detect
# .runtime\postgres\*\bin, then C:\Program Files\PostgreSQL\*\bin
PG_BIN=
PG_PORT=55432
# Set a password here, or leave empty and 'kira.ps1 init' generates one into .runtime\db.pass
DB_PASSWORD=

# --- Only when HTTPS reverse proxy fronts the dashboard -----------------------
COOKIE_SECURE=false
TRUST_PROXY=false

# Disk spill: if PostgreSQL is down, batches are parked here and replayed automatically (set by kira.ps1).
# SPILL_MAX_MB=500
# Prometheus metrics at /metrics (Bearer token). Disabled when unset.
# METRICS_TOKEN=change-me
